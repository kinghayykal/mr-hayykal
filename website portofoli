<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hayykal Azzam | Developer Terminal</title>
    <!-- Mengimpor font Fira Code dari Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        /* === VARIABEL WARNA & TEMA === */
        :root {
            --bg-dark: #000000;
            --bg-panel: #111111;
            --text-green: #00FF41;
            --text-cyan: #00E5FF;
            --glow-green: 0 0 8px rgba(0, 255, 65, 0.6);
            --glow-cyan: 0 0 8px rgba(0, 229, 255, 0.6);
            --font-main: 'Fira Code', monospace;
        }

        /* === RESET & PENGATURAN DASAR === */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-green);
            font-family: var(--font-main);
            font-size: 15px;
            line-height: 1.6;
            padding: 20px;
            display: flex;
            justify-content: center;
            min-height: 100vh;
            /* Efek scanline halus ala monitor CRT */
            background-image: linear-gradient(rgba(0, 255, 65, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(0, 255, 65, 0.03) 1px, transparent 1px);
            background-size: 1px 2px, 2px 1px;
        }

        /* === KONTANER TERMINAL === */
        .terminal-container {
            width: 100%;
            max-width: 900px;
            background-color: var(--bg-panel);
            border: 1px solid var(--text-green);
            box-shadow: var(--glow-green);
            border-radius: 5px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* === HEADER TERMINAL === */
        .terminal-header {
            background-color: #222;
            padding: 5px 15px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--text-green);
            font-size: 13px;
        }

        .window-controls {
            display: flex;
            gap: 8px;
            margin-right: 15px;
        }

        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }
        .dot-red { background-color: #ff5f56; }
        .dot-yellow { background-color: #ffbd2e; }
        .dot-green { background-color: #27c93f; }

        .terminal-title {
            color: #ddd;
            flex-grow: 1;
            text-align: center;
            margin-right: 50px;
        }

        /* === AREA KONTEN UTAMA === */
        .terminal-body {
            padding: 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        /* === NAVIGASI === */
        nav {
            margin-bottom: 30px;
            border-bottom: 1px dashed var(--text-green);
            padding-bottom: 15px;
        }

        .nav-list {
            list-style: none;
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }

        .nav-item {
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .nav-item::before {
            content: "[";
            color: var(--text-cyan);
        }
        .nav-item::after {
            content: "]";
            color: var(--text-cyan);
        }

        .nav-item:hover, .nav-item.active {
            color: var(--text-cyan);
            text-shadow: var(--glow-cyan);
        }

        /* === BAGIAN KONTEN === */
        .section {
            display: none; /* Disembunyikan secara default, diatur oleh JS */
            flex-grow: 1;
            animation: fadeIn 0.5s ease;
        }

        .section.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Teks & Utilitas */
        h1, h2, h3 {
            color: var(--text-cyan);
            text-shadow: var(--glow-cyan);
            margin-bottom: 15px;
            font-weight: 600;
        }

        .cyan-text {
            color: var(--text-cyan);
            text-shadow: var(--glow-cyan);
        }

        .prompt::before {
            content: "hayykal@GDG:~$ ";
            color: var(--text-cyan);
            text-shadow: var(--glow-cyan);
        }

        .cursor {
            display: inline-block;
            width: 10px;
            height: 18px;
            background-color: var(--text-green);
            vertical-align: middle;
            animation: blink 1s step-end infinite;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }

        /* === FORMAT TABEL SPESIFIKASI === */
        .tech-specs {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        .tech-specs td {
            padding: 8px 0;
            border-bottom: 1px dotted rgba(0, 255, 65, 0.3);
        }

        .tech-specs td:first-child {
            width: 25%;
            color: var(--text-cyan);
            font-weight: bold;
        }

        .tech-specs td:nth-child(2) {
            width: 5%;
            text-align: center;
        }

        /* === FORMAT DIREKTORI PROYEK === */
        .dir-list {
            list-style: none;
            margin-top: 15px;
        }

        .dir-list li {
            margin-bottom: 8px;
            display: flex;
            gap: 15px;
        }

        .permissions { color: #888; }
        .size { color: #aa55ff; }
        .date { color: #ffff55; }
        .filename { color: var(--text-cyan); text-shadow: var(--glow-cyan); }

        /* === FOOTER / KUTIPAN === */
        .terminal-footer {
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px dashed var(--text-green);
            text-align: center;
            font-style: italic;
            color: #888;
            font-size: 13px;
        }

        .terminal-footer span {
            color: var(--text-cyan);
        }
    </style>
</head>
<body>

