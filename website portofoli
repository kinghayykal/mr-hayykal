    <!-- JavaScript untuk interaksi -->
    <script>
        // Logika Navigasi Tab
        function showSection(sectionId) {
            // Sembunyikan semua bagian
            const sections = document.querySelectorAll('.section');
            sections.forEach(sec => sec.classList.remove('active'));

            // Hapus status aktif dari semua menu navigasi
            const navItems = document.querySelectorAll('.nav-item');
            navItems.forEach(item => item.classList.remove('active'));

            // Tampilkan bagian yang diklik
            document.getElementById(sectionId).classList.add('active');

            // Tambahkan status aktif pada menu yang diklik
            // Mencari elemen berdasarkan event yang memicu (jika ada) atau pencocokan teks
            const targetNav = Array.from(navItems).find(nav => 
                nav.getAttribute('onclick').includes(sectionId)
            );
            if (targetNav) targetNav.classList.add('active');
        }

        // Logika Efek Ketik (Typewriter)
        const textToType = `>_ MENGINISIALISASI SISTEM... [OK]
>_ MEMUAT KEAHLIAN JAVA... [OK]
>_ MENGHUBUNGKAN KE SERVER GDG... [OK]

Selamat datang.
Saya Muhammad Hayykal Azzam, siap untuk mulai melakukan coding.`;
        
        const typeTarget = document.getElementById('typewriter-text');
        let i = 0;
        const speed = 40; // Kecepatan ketik (ms)

        function typeWriter() {
            if (i < textToType.length) {
                // Menangani baris baru dengan benar untuk HTML
                if (textToType.charAt(i) === '\n') {
                    typeTarget.innerHTML += '<br>';
                } else {
                    typeTarget.innerHTML += textToType.charAt(i);
                }
                i++;
                setTimeout(typeWriter, speed);
            }
        }

        // Mulai efek ketik saat halaman selesai dimuat
        window.onload = () => {
            typeWriter();
        };
    </script>
</body>
</html>
